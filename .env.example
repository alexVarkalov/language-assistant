# From @BotFather
BOT_TOKEN=

# Required: DeepL API key (https://www.deepl.com/pro-api) — MyMemory fallback is disabled.
DEEPL_API_KEY=

# free (default): https://api-free.deepl.com — typical “DeepL API Free” keys from the account page.
# pro: https://api.deepl.com — paid DeepL API (Pro) subscriptions only.
# auto: try Free host first, then Pro if the first returns HTTP 403.
DEEPL_PLAN=free

# Only deepl is supported.
TRANSLATOR=deepl

# This deployment's fixed language pair. Direction is auto-detected per message by script
# (Cyrillic vs Latin), so one language must be Cyrillic-script (e.g. RU) and the other
# Latin-script (e.g. PL) — order doesn't matter. To support a different pair, deploy a
# separate instance of this bot (new bot token, .env, database).
SOURCE_LANG=PL
TARGET_LANG=RU

# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/language_assistant

# How often to check for due reviews, in seconds (minimum 15)
DUE_POLL_INTERVAL=45

# Short review delay in minutes, used for first review and after grading "Again" (minimum 1)
SHORT_REVIEW_INTERVAL_MINUTES=10

# Comma-separated Telegram user IDs allowed to manage user access (/users, /allow_user, /block_user)
ADMIN_USER_IDS=
